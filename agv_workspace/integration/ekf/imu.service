[Unit]
Description=Feedbot read-only WIT gyro ROS2 adapter
Requires=feedbot-nav2-engine.service
After=feedbot-nav2-engine.service

[Service]
Type=simple
ExecStart=/opt/feedbot-nav2/docker/docker -H unix:///run/feedbot-nav2-docker.sock run --rm --name feedbot-imu --network host --ipc host --pid host --cap-add SYS_PTRACE --security-opt apparmor=unconfined --device /dev/rikiimu:/dev/rikiimu -e ROS_DOMAIN_ID=89 -e ROS_LOCALHOST_ONLY=1 -e RMW_IMPLEMENTATION=rmw_fastrtps_cpp -v /opt/feedbot-integration/releases/20261122-imu-baseline-01:/work:ro --entrypoint /bin/bash feedbot-navigation:jazzy-20261122 -c 'source /opt/ros/jazzy/setup.bash; exec /work/install/lib/feedbot_imu_ros2/imu_node'
ExecStop=/opt/feedbot-nav2/docker/docker -H unix:///run/feedbot-nav2-docker.sock stop -t 10 feedbot-imu
TimeoutStopSec=20
Restart=no
