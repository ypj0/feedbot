<?xml version="1.0"?>
<robot name="feedbot_chassis">
  <link name="base_link"/>
  <link name="base_footprint"/>
  <link name="left_wheel_link"/>
  <link name="right_wheel_link"/>
  <link name="imu_link"/>
  <link name="laser_link"/>
  <link name="scan"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_link"/>
    <origin xyz="0.27 0 0.20" rpy="0 0 0"/>
  </joint>
  <joint name="scan_joint" type="fixed">
    <parent link="laser_link"/><child link="scan"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/><child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/>
    <origin xyz="0 0.2275 0.085"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/>
    <origin xyz="0 -0.2275 0.085"/><axis xyz="0 1 0"/>
  </joint>
  <ros2_control name="FeedbotChassis" type="system">
    <hardware><plugin>feedbot_chassis_ros2/ChassisSystem</plugin></hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>
</robot>
